{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd toxic-comment-frontend && npm run build",
  "devCommand": "cd toxic-comment-frontend && npm run dev",
  "installCommand": "cd toxic-comment-frontend && npm install",
  "framework": "nextjs",
  "outputDirectory": "toxic-comment-frontend/.next",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/toxic-comment-frontend/$1"
    }
  ]
}
